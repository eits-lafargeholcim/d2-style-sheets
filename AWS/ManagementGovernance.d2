classes: {
    AWSManagementGovernance-Organization: {
        icon: https://d2-images.holcim.digital/AWS/ManagementGovernance/AWS-Organizations_light-bg.svg
        icon.near: top-left
        label.near: top-center
        style:{
            fill: transparent
            bold: true
            font-size: 64
            stroke-width: 8
            stroke: '#C82636'
            border-radius: 3
        }
    }
    AWSManagementGovernance-OU: {
        icon: https://d2-images.holcim.digital/AWS/ManagementGovernance/AWS-Organizations_Organizational-unit_light-bg.svg
        icon.near: top-left
        label.near: top-center
        style:{
            fill: transparent
            bold: true
            stroke-width: 2
            stroke-dash: 3
            stroke: '#C82636'
        }
    }
    AWSManagementGovernance-Account: {
        icon: https://d2-images.holcim.digital/AWS/ManagementGovernance/AWS-Organizations_Account_light-bg.svg
        shape: image
        width: 180
        height:180
    }
    AWSManagementGovernance-SCP: {
        icon: https://d2-images.holcim.digital/AWS/ManagementGovernance/AWS-Identity-and-Access-Management-IAM_Permissions_light-bg.svg
        shape: image
        style.font-color: '#C82636'
        width: 50
        height: 50
    }
    AWSManagementGovernance-SCPBox: {
        label.near: top-center
        style:{
            fill: '#FCEAE5'
            border-radius: 8
            stroke: '#C82636'
        }
    }
    AWSManagementGovernance-CloudWatch-Rule: {
        icon: https://d2-images.holcim.digital/AWS/ManagementGovernance/Amazon-CloudWatch_Rule_light-bg.svg
        shape: image
        width: 90
        height: 90
    }
}